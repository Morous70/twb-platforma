# Zakázat výpis adresářů a přímý přístup ke konfiguraci
Options -Indexes
<FilesMatch "^(config\.php|config\.sample\.php|README\.md)$">
  Require all denied
</FilesMatch>

# Instalace jako aplikace (PWA)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
