# TWB Reklamy – Apache (Wedos NoLimit)
Options -Indexes
<FilesMatch "^(VERSION|modules\.lock|build\.json|BUILD\.json|config\.php|config\.sample\.php|README\.md)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
