# TWB Media galerie – Apache (Wedos NoLimit)
Options -Indexes
<FilesMatch "^(VERSION|modules\.lock|build\.json|BUILD\.json|config\.php|config\.sample\.php|README\.md)$">
    Require all denied
</FilesMatch>
# moduly platformy se načítají jen z PHP (písma a editor slidů vydávají api.php a asset.php)
<IfModule mod_alias.c>
    RedirectMatch 404 "/modules/"
    RedirectMatch 404 "/help/"
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# API: hlavička Authorization se při běhu PHP přes CGI/FastCGI jinak ztratí (záloha: hlavička X-Api-Key)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
