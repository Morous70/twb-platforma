# TWB Media galerie – Apache (Wedos NoLimit)
Options -Indexes
# kořen domény = veřejný web (0.8.0); administrace zůstává na index.php
DirectoryIndex verejne.php index.php
# ads.txt pro reklamní systémy (0.8.2): obsah se zadává v administraci (Veřejný web), vydá ho verejne.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ads\.txt$ verejne.php?s=ads.txt [L]
</IfModule>
<FilesMatch "^(VERSION|modules\.lock|build\.json|BUILD\.json|config\.php|config\.sample\.php|README\.md)$">
    Require all denied
</FilesMatch>
# moduly platformy se načítají jen z PHP (písma a editor slidů vydávají api.php a asset.php)
<IfModule mod_alias.c>
    RedirectMatch 404 "/modules/"
    RedirectMatch 404 "/help/"
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# API: hlavička Authorization se při běhu PHP přes CGI/FastCGI jinak ztratí (záloha: hlavička X-Api-Key)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
